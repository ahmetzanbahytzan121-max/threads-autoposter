# Промокод из Freedom SuperApp (раздел Сервисы -> Продукты -> пригласить друга)
PROMO_CODE=YOUR_PROMO_CODE

# Данные из Meta for Developers (заполняются автоматически через setup-token или вручную)
THREADS_APP_SECRET=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_USERNAME=
THREADS_TOKEN_UPDATED_AT=

# Поведение очереди:
# false = остановиться после публикации всех постов
# true = идти по кругу, выбирая самые старые посты
LOOP_QUEUE=true

# Базовый публичный HTTPS URL для картинок из assets/ (например, https://raw.githubusercontent.com/USER/REPO/main)
IMAGE_BASE_URL=

# Пауза между основным постом и комментарием с промокодом (в секундах)
REPLY_DELAY_SEC=3
